---
layout: null
---
{%- assign items = "" | split: "" -%}
[
{%- for post in site.posts -%}
  {%- assign tags = post.tags | join: " " -%}
  {%- capture text -%}{{ post.excerpt | strip_html | strip }} {{ tags }} {{ post.topic }}{%- endcapture -%}
  {"title": {{ post.title | jsonify }}, "kind": "article", "text": {{ text | jsonify }}, "url": {{ post.link | default: post.url | relative_url | jsonify }}, "date": {{ post.date | date: "%d %b %Y" | jsonify }}}{% if forloop.last == false or site.talks.size > 0 or site.projects.size > 0 %},{% endif %}
{%- endfor -%}
{%- for talk in site.talks -%}
  {%- capture text -%}{{ talk.excerpt | strip_html | strip }} {{ talk.event }} {{ talk.location }}{%- endcapture -%}
  {"title": {{ talk.title | jsonify }}, "kind": "talk", "text": {{ text | jsonify }}, "url": {{ '/talks/' | relative_url | jsonify }}, "date": {{ talk.date | date: "%d %b %Y" | jsonify }}}{% if forloop.last == false or site.projects.size > 0 %},{% endif %}
{%- endfor -%}
{%- for project in site.projects -%}
  {%- assign tags = project.tags | join: " " -%}
  {%- capture text -%}{{ project.excerpt | strip_html | strip }} {{ project.category }} {{ tags }}{%- endcapture -%}
  {"title": {{ project.title | jsonify }}, "kind": "project", "text": {{ text | jsonify }}, "url": {{ '/projects/' | relative_url | jsonify }}, "date": ""}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
